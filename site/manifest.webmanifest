{
  "name": "Learn Braille",
  "short_name": "Braille",
  "description": "A resource for sighted folks to learn the braille writing system.",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3efea",
  "theme_color": "#f3efea",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Practise with Auto",
      "short_name": "Auto",
      "url": "./#/practice/read?cat=auto&set=all",
      "icons": [
        { "src": "icons/shortcut-auto.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "Translate",
      "short_name": "Translate",
      "url": "./#/translate",
      "icons": [
        { "src": "icons/shortcut-translate.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "Play Braidle",
      "short_name": "Braidle",
      "url": "./#/games/wordle",
      "icons": [
        { "src": "icons/shortcut-braidle.png", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ]
}
